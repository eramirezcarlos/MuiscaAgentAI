# Copy this file to .env and fill it in. .env is ignored by git; never commit a real key.

# Claude API key, from https://platform.claude.com/
ANTHROPIC_API_KEY=

# Base URL of the Laravel API. Production is https://api.muisca.ca
MUISCA_API_URL=http://localhost:8000

# Optional. claude-haiku-5-5 is cheaper.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Browser origins allowed to call POST /chat, comma-separated.
# CORS_ORIGINS=http://localhost:3000
